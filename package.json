{
  "name": "@local/dsh-yapi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin that connects to a YAPI documentation service, lists configured projects, and lets the agent generate interface docs back into a project.",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "src"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
