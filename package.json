{
  "name": "dsh-yapi",
  "version": "1.0.0",
  "description": "Connect DeepSeek Harness to a YAPI service: generate interface documentation automatically through agent conversation, then sync the approved changes back to the remote YAPI documentation service.",
  "type": "module",
  "license": "MIT",
  "author": "dsh-yapi contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyy-hast/dsh-yapi.git"
  },
  "homepage": "https://github.com/lyy-hast/dsh-yapi#readme",
  "bugs": {
    "url": "https://github.com/lyy-hast/dsh-yapi/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "cordis",
    "yapi"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.md",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
